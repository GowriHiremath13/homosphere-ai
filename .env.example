# ---------- Server ----------
PORT=4000

# Public URL of the app AS SEEN BY THE PHONE (used inside the pairing QR code).
# Dev (Vite):        http://localhost:5173  (localhost is auto-swapped for your LAN IP)
# Production build:  http://<your-LAN-IP>:4000
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# PostgreSQL connection string (used by Prisma). Leave empty to run with a volatile in-memory
# store instead (demo only, data lost on restart) - handy for a quick first run.
# Format:  postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local:   postgresql://homesphere:homesphere@localhost:5432/homesphere
# See README.md "PostgreSQL setup" for installing Postgres, creating the user/database, and
# running the Prisma migration + seed before this will actually work.
DATABASE_URL=postgresql://homesphere:Gowri@localhost:5432/homesphere
# Set to true to refuse to start when PostgreSQL is unreachable/un-migrated (recommended for production)
REQUIRE_DB=false

# ---------- AI (backend only, never sent to the browser) ----------
AI_API_KEY=curl https://api.anthropic.com/v1/organizations/api_keys/$API_KEY_ID \
    -H 'anthropic-version: 2023-06-01' \
    -H "X-Api-Key: $ANTHROPIC_API_KEY
# anthropic | openai  (openai = any OpenAI-compatible /chat/completions endpoint)
AI_PROVIDER=anthropic
# Defaults: claude-sonnet-5 (anthropic) / gpt-4o-mini (openai)
AI_MODEL=
# Optional override, e.g. https://api.anthropic.com or https://api.openai.com/v1
AI_BASE_URL=

# ---------- Demo mode ----------
# true  = mock weather + canned AI + sample data, no external API needed
# false = real providers. If unset: demo is ON when AI_API_KEY is empty.
DEMO_MODE=

# ---------- Weather ----------
# mock | open-meteo (free, no key). Used when demo mode is OFF.
WEATHER_PROVIDER=open-meteo
WEATHER_LOCATION_NAME=Bengaluru, India
WEATHER_LAT=12.9716
WEATHER_LON=77.5946

# ---------- Device / pairing ----------
DEVICE_NAME=Living Room TV
PAIRING_TTL_MINUTES=10
